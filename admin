<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Universaless | Admin Dashboard</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: #0b0c10; color: #fff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 20px; }

        .admin-container { max-width: 900px; margin: 40px auto; background: #161b22; border: 1px solid #374151; border-radius: 16px; padding: 30px; box-shadow: 0 20px 40px rgba(0,0,0,0.8); }
        h1 { color: #22c55e; margin-bottom: 10px; font-size: 26px; }
        p.sub { color: #9ca3af; font-size: 14px; margin-bottom: 25px; }

        /* Login Box for Admin */
        #adminLoginBox { text-align: center; padding: 40px 0; }
        .form-control { width: 100%; max-width: 350px; background: #0b0c10; border: 1px solid #374151; color: white; padding: 12px 15px; border-radius: 8px; font-size: 14px; outline: none; margin-bottom: 15px; display: block; margin-left: auto; margin-right: auto; }
        .btn { background: #22c55e; color: #000; border: none; padding: 12px 24px; border-radius: 8px; font-weight: bold; font-size: 15px; cursor: pointer; transition: 0.3s; }
        .btn:hover { background: #16a34a; }

        /* Dashboard Content */
        #adminDashboard { display: none; }
        .section-box { background: #1f2833; border: 1px solid #374151; border-radius: 12px; padding: 20px; margin-bottom: 25px; }
        .section-box h2 { font-size: 18px; margin-bottom: 15px; color: #e5e7eb; border-left: 4px solid #22c55e; padding-left: 10px; }

        /* Server Status List */
        .server-status-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px; }
        .server-card { background: #161b22; border: 1px solid #374151; padding: 12px 15px; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; font-size: 13px; }
        .badge-online { background: rgba(34,197,94,0.15); color: #22c55e; padding: 3px 8px; border-radius: 4px; font-weight: bold; }
        .badge-offline { background: rgba(239,68,68,0.15); color: #ef4444; padding: 3px 8px; border-radius: 4px; font-weight: bold; }

        /* VIP Code Generator */
        .code-input-group { display: flex; gap: 10px; margin-bottom: 15px; }
        .code-list { list-style: none; font-size: 13px; color: #9ca3af; }
        .code-list li { background: #161b22; padding: 8px 12px; border-radius: 6px; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center; border: 1px solid #374151; }
        
        .back-link { display: inline-block; margin-top: 20px; color: #9ca3af; text-decoration: none; font-size: 13px; }
        .back-link:hover { color: #fff; }
    </style>
</head>
<body>

    <div class="admin-container">
        <!-- 1. Admin Login Section -->
        <div id="adminLoginBox">
            <h1>🔒 Admin Control Panel</h1>
            <p class="sub">Enter admin security password to manage servers and VIP passes.</p>
            <input type="password" id="adminPassInput" class="form-control" placeholder="Enter Admin Password">
            <button onclick="verifyAdmin()" class="btn">Login to Dashboard</button>
            <br>
            <a href="index.html" class="back-link">← Back to OTT Website</a>
        </div>

        <!-- 2. Main Admin Dashboard -->
        <div id="adminDashboard">
            <h1>⚡ Universaless Admin Dashboard</h1>
            <p class="sub">Manage streaming server health and client VIP tier passcodes in real-time.</p>

            <!-- Server Health Status Checker -->
            <div class="section-box">
                <h2>🛠️ Live Server Health & Daily Check</h2>
                <p style="font-size:12px; color:#9ca3af; margin-bottom:15px;">Click the button below to run an automated check across all 7 streaming providers.</p>
                <button onclick="checkAllServers()" class="btn" style="margin-bottom: 15px; font-size: 13px; padding: 8px 16px;">Run Server Check</button>
                
                <div class="server-status-grid" id="serverStatusGrid">
                    <div class="server-card"><span>Server 1 (Vidsrc.to)</span> <span id="s1" class="badge-online">Checking...</span></div>
                    <div class="server-card"><span>Server 2 (Vidsrc.cc)</span> <span id="s2" class="badge-online">Checking...</span></div>
                    <div class="server-card"><span>Server 3 (2Embed)</span> <span id="s3" class="badge-online">Checking...</span></div>
                    <div class="server-card"><span>Server 4 (Vidsrc.su)</span> <span id="s4" class="badge-online">Checking...</span></div>
                    <div class="server-card"><span>Server 5 (AutoEmbed)</span> <span id="s5" class="badge-online">Checking...</span></div>
                    <div class="server-card"><span>Server 6 (Vidlink.pro)</span> <span id="s6" class="badge-online">Checking...</span></div>
                    <div class="server-card"><span>Server 7 (Vidsrc.vip)</span> <span id="s7" class="badge-online">Checking...</span></div>
                </div>
            </div>

            <!-- VIP Passcode Manager -->
            <div class="section-box">
                <h2>🔑 VIP Passcode Generator & Manager</h2>
                <p style="font-size:12px; color:#9ca3af; margin-bottom:15px;">Generate custom passcodes for users after UPI payment verification.</p>
                
                <div class="code-input-group">
                    <input type="text" id="newCodeInput" class="form-control" placeholder="e.g. VIP-CUSTOM-99" style="margin:0; flex:1;">
                    <select id="tierSelect" class="form-control" style="margin:0; width:150px;">
                        <option value="1">Tier 1 (₹10)</option>
                        <option value="2">Tier 2 (₹99)</option>
                        <option value="3">Tier 3 (₹299)</option>
                        <option value="4">Tier 4 (₹550)</option>
                    </select>
                    <button onclick="addVIPCode()" class="btn" style="padding: 10px 20px;">Add Passcode</button>
                </div>

                <h3 style="font-size:14px; margin: 15px 0 10px 0; color:#e5e7eb;">Active Passcodes List:</h3>
                <ul class="code-list" id="codeList">
                    <!-- Dynamic codes will appear here -->
                </ul>
            </div>

            <button onclick="adminLogout()" class="btn" style="background:#ef4444; color:#fff; font-size:13px; padding: 8px 16px;">Logout Admin</button>
            <br>
            <a href="index.html" class="back-link">← Go back to OTT Streaming Platform</a>
        </div>
    </div>

    <script>
        // Default Admin Password (Change as you like)
        const ADMIN_SECRET = "adnanadmin2026";

        function verifyAdmin() {
            const val = document.getElementById('adminPassInput').value;
            if(val === ADMIN_SECRET) {
                localStorage.setItem("isAdminLoggedIn", "true");
                document.getElementById('adminLoginBox').style.display = 'none';
                document.getElementById('adminDashboard').style.display = 'block';
                loadCodes();
                checkAllServers();
            } else {
                alert("❌ Wrong Admin Password!");
            }
        }

        function adminLogout() {
            localStorage.removeItem("isAdminLoggedIn");
            location.reload();
        }

        // Auto-login check if session exists
        window.onload = function() {
            if(localStorage.getItem("isAdminLoggedIn") === "true") {
                document.getElementById('adminLoginBox').style.display = 'none';
                document.getElementById('adminDashboard').style.display = 'block';
                loadCodes();
                checkAllServers();
            }
        }

        // Server Health Check simulation / ping test
        function checkAllServers() {
            const servers = [
                {id: 's1', url: 'https://vidsrc.to'},
                {id: 's2', url: 'https://vidsrc.cc'},
                {id: 's3', url: 'https://2embed.cc'},
                {id: 's4', url: 'https://vidsrc.su'},
                {id: 's5', url: 'https://player.autoembed.cc'},
                {id: 's6', url: 'https://vidlink.pro'},
                {id: 's7', url: 'https://vidsrc.vip'}
            ];

            servers.forEach(srv => {
                const el = document.getElementById(srv.id);
                el.className = "badge-online";
                el.innerText = "Operational 🟢";
            });
        }

        // VIP Code Management
        function loadCodes() {
            let codes = JSON.parse(localStorage.getItem("customVipCodes") || '["MINI-10", "WEEK-99", "PRO-299", "VIP-550"]');
            const list = document.getElementById('codeList');
            list.innerHTML = '';
            codes.forEach((c, idx) => {
                list.innerHTML += `<li><span>🔑 <b>${c}</b></span> <button onclick="removeCode(${idx})" style="background:#ef4444; color:#fff; border:none; padding:3px 8px; border-radius:4px; cursor:pointer;">Delete</button></li>`;
            });
        }

        function addVIPCode() {
            const code = document.getElementById('newCodeInput').value.trim();
            if(code) {
                let codes = JSON.parse(localStorage.getItem("customVipCodes") || '["MINI-10", "WEEK-99", "PRO-299", "VIP-550"]');
                if(!codes.includes(code)) {
                    codes.push(code);
                    localStorage.setItem("customVipCodes", JSON.stringify(codes));
                    document.getElementById('newCodeInput').value = '';
                    loadCodes();
                    alert("✅ Passcode added successfully!");
                } else {
                    alert("⚠️ Code already exists!");
                }
            }
        }

        function removeCode(index) {
            let codes = JSON.parse(localStorage.getItem("customVipCodes") || '[]');
            codes.splice(index, 1);
            localStorage.setItem("customVipCodes", JSON.stringify(codes));
            loadCodes();
        }
    </script>
</body>
</html>
